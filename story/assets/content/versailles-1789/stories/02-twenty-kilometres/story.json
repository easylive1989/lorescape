              ]
            },
            {
              "text": "繼續走。",
              "add": {
                "together": 1
              },
              "then": [
                {
                  "t": "n",
                  "text": "我看著她往回走，走成一個點。"
                },
                {
                  "t": "n",
                  "text": "然後我轉過來，繼續走我這個方向。"
                }
              ]
            }
          ]
        }
      ],
      "next": "S06"
    },
    "S05B": {
      "title": "大道後段・正午",
      "background": "road",
      "bgm": "rain",
      "nodes": [
