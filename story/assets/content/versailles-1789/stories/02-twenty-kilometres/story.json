        {
          "t": "show",
          "who": "catherine",
          "sprite": "weary"
        },
        {
          "t": "d",
          "who": "catherine",
          "text": "到了。"
        },
        {
          "t": "d",
          "who": "marguerite",
          "text": "那是……"
        },
        {
          "t": "d",
          "who": "catherine",
          "text": "宮。"
