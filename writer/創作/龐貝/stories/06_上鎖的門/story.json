                    "value": 2
                  },
                  "goto": "E_A"
                },
                {
                  "default": true,
                  "goto": "E_C"
                }
              ]
            },
            {
              "text": "把鑰匙掛回去。",
              "goto": "E_B"
            }
          ]
        }
      ]
    },
    "E_A": {
      "title": "結局 A｜開門",
      "background": "ludus",
      "bgm": null,
      "isEnding": true,
      "endingId": "A",
      "nodes": [
        {
          "t": "n",
          "text": "鎖很澀。我試了三把才對。"
        },
        {
          "t": "n",
          "text": "門往內開，外面沒有堆積，一推就開了。"
        },
        {
          "t": "n",
          "text": "裡面很暗，三個人坐在地上，腳都在同一根鐵條上。"
        },
        {
          "t": "n",
          "text": "鐵條穿過牆裡的環，兩頭用銷子固定。"
        },
        {
          "t": "n",
          "text": "我用耙子的柄插進去撬。奧瑞斯特斯用手拉另一頭。"
